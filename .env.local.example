# ─── Supabase ─────────────────────────────────────────────────────────────────
# Cliente (público por design — anon key). Usado pelo formulário de cadastro.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (service role — NUNCA expor no cliente). Usado por: /api/eventos,
# /api/checkin, /api/webhook/asaas, /api/checkout/validate-coupon (DB), /api/professores/clientes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps (Embed/JS API) ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Asaas (checkout/pagamentos) ──────────────────────────────────────────────
# Header de auth é `access_token` (não Bearer); base hard-coded https://api.asaas.com/v3.
ASAAS_API_KEY=
# Opcional: split/wallet (a GESTÃO lê mas não aplica split hoje).
ASAAS_WALLET_ID=
# Token do webhook Asaas (OBRIGATÓRIO para /api/webhooks/asaas funcionar).
ASAAS_WEBHOOK_TOKEN=

# ─── Cupons (registro de resgate via POST — opcional) ─────────────────────────
# Espelha CHECKOUT_API_SECRET da GESTÃO. Só necessário se ativarmos o POST de resgate.
CHECKOUT_API_SECRET=

# ─── Resend (e-mails transacionais) ───────────────────────────────────────────
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Somma Club <contato@sommaclub.com.br>")
VIP_EMAIL_FROM=

# ─── O Longão (/admin/o-longao) ───────────────────────────────────────────────
# Senha única do painel do O Longão. Quem entra aprova/reprova crews, edita
# inscrições, marca classificadas e publica resultados.
O_LONGAO_ADMIN_PASSWORD=

# ─── Estação SOMMA · versão 2 (/ppt-estacao-somma-2) ──────────────────────────
# Código de acesso deste deck, OBRIGATÓRIO: diferente das outras apresentações,
# esta não tem código padrão no fonte. Cai em PPT_ESTACAO_SOMMA_CODE quando não
# está definida. O cookie é assinado com AUTH_SECRET, não com o código.
PPT_ESTACAO_SOMMA_2_CODE=
# Opcional: URL do protótipo do app no QR code. Sem ela, produção usa
# https://sommaclub.com.br/ppt-estacao-somma-2/app e o dev usa o host da requisição.
ESTACAO_SOMMA_2_APP_URL=
