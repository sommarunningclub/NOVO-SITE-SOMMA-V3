# ─── Assinatura de sessão (OBRIGATÓRIO) ───────────────────────────────────────
# Chave dedicada que assina TODO cookie de sessão e todo token do site: admin de
# campanhas, operação do Desafio das Esteiras, Insider, decks /ppt-*, sessão de
# checkout do Asaas, código de transferência de inscrição e token de edição de
# equipe do Wings.
#
# Gere com: openssl rand -base64 32
#
# Já foi possível cair em SUPABASE_SERVICE_ROLE_KEY quando esta faltava. Não é
# mais: reaproveitar a chave de acesso total ao banco como chave de assinatura
# junta dois segredos de gravidades diferentes, e obriga a rotacionar os dois
# juntos. Sem AUTH_SECRET, nenhuma sessão é emitida ou aceita.
AUTH_SECRET=
# Nome antigo da mesma coisa, ainda aceito como fallback. AUTH_SECRET vem primeiro.
INSIDER_SESSION_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Cliente (público por design — anon key). Usado pelo formulário de cadastro.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (service role — NUNCA expor no cliente, NUNCA em NEXT_PUBLIC_*).
# Usado por: /api/eventos, /api/checkin, /api/webhook/asaas,
# /api/checkout/validate-coupon (DB), /api/professores/clientes, /api/insider/*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps (Embed/JS API) ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Asaas (checkout/pagamentos) ──────────────────────────────────────────────
# Header de auth é `access_token` (não Bearer); base hard-coded https://api.asaas.com/v3.
# O PREÇO não vem mais do navegador: o catálogo é lib/checkout/planos.ts e o
# cálculo é lib/asaas/checkout-pricing.ts. O cliente escolhe o plano; o servidor
# decide o valor.
ASAAS_API_KEY=
# Opcional: split/wallet (a GESTÃO lê mas não aplica split hoje).
ASAAS_WALLET_ID=
# Token do webhook Asaas — OBRIGATÓRIO. A rota é /api/webhook/asaas (singular) e
# é fail-closed: sem este token ela responde 503 e não processa evento nenhum,
# em vez de aceitar qualquer POST anônimo escrevendo em `payments`.
# Cadastre o mesmo valor no painel do Asaas, em Integrações → Webhooks.
ASAAS_WEBHOOK_TOKEN=

# ─── Cupons (registro de resgate via POST — opcional) ─────────────────────────
# Espelha CHECKOUT_API_SECRET da GESTÃO. Só necessário se ativarmos o POST de resgate.
CHECKOUT_API_SECRET=

# ─── Resend (e-mails transacionais) ───────────────────────────────────────────
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Somma Club <contato@sommaclub.com.br>")
# Também usado pelo código de transferência de inscrição: sem remetente, a
# transferência não sai do lugar.
VIP_EMAIL_FROM=
# Segredo de assinatura do webhook de eventos (/api/webhooks/resend).
# Vem do `signing_secret` devolvido na CRIAÇÃO do webhook, e só ali: a listagem
# não expõe. OBRIGATÓRIO para a régua de campanhas — sem ele as aberturas não são
# capturadas e as etapas 2 e 3 não sabem quem não abriu.
RESEND_WEBHOOK_SECRET=

# ─── Campanhas (/admin/campanhas) ─────────────────────────────────────────────
# Senha única do módulo de régua de disparo. Quem entra manda e-mail para a base.
CAMPANHAS_ADMIN_PASSWORD=
# Segredo do cron de disparo (rotas /api/campanhas*/cron).
CRON_SECRET=

# ─── Desafio das Esteiras (/admin/desafio-das-esteiras) ───────────────────────
DESAFIO_ESTEIRAS_ADMIN_PASSWORD=
# Senha compartilhada das páginas por unidade (papel que só acompanha e valida).
DESAFIO_ESTEIRAS_UNIDADE_PASSWORD=
# Opcional, por unidade: DESAFIO_ESTEIRAS_OP_<UNIDADE>_PASSWORD dá poder de edição.

# ─── O Longão (/admin/o-longao) ───────────────────────────────────────────────
# Senha única do painel do O Longão. Quem entra aprova/reprova crews, edita
# inscrições, marca classificadas e publica resultados.
O_LONGAO_ADMIN_PASSWORD=

# ─── Wings (cronometragem/competição) ─────────────────────────────────────────
# Chave do staff. Trocada por cookie assinado em POST /api/wings-comp/login;
# sem ela, as rotas de atléticas, atletas, runs e config ficam fechadas.
WINGS_ADMIN_KEY=

# ─── Decks comerciais (/ppt-*) ────────────────────────────────────────────────
# Código de acesso de cada apresentação. OBRIGATÓRIO: não existe mais código
# padrão no fonte — sem a variável, o deck não abre para ninguém.
# O cookie é assinado com AUTH_SECRET, não com o código.
PPT_MICHELOB_CODE=
PPT_SILVER_CARE_CODE=
PPT_ESTACAO_SOMMA_CODE=
# Opcionais: sobrescrevem PPT_MICHELOB_CODE nessas duas propostas.
PPT_MICHELOB_PROPOSTA_CODE=
PPT_MICHELOB_NOVA_PROPOSTA_CODE=

# ─── Rate limit distribuído (opcional, recomendado em produção) ───────────────
# Sem estas duas, o contador é em memória — some a cada instância nova da função
# e não é compartilhado entre elas, ou seja, freia bot mas não força bruta
# distribuída. Com elas, a cota passa a valer de verdade para login do Insider,
# checkout, verify-cpf, check-in, Par-Q, decks e uploads.
# Crie um banco Redis no Upstash e copie as credenciais REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Previews internas ────────────────────────────────────────────────────────
# As páginas /desafios-das-esteiras-evolve/email-preview* respondem 404 em
# produção. Defina como "true" só se precisar abri-las em produção por um tempo.
EMAIL_PREVIEW_ABERTA=
