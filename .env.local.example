# ─── Supabase ─────────────────────────────────────────────────────────────────
# Cliente (público por design — anon key). Usado pelo formulário de cadastro.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (service role — NUNCA expor no cliente). Usado por: /api/eventos,
# /api/checkin, /api/webhook/asaas, /api/checkout/validate-coupon (DB), /api/professores/clientes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps (Embed/JS API) ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Asaas (checkout/pagamentos) ──────────────────────────────────────────────
# Header de auth é `access_token` (não Bearer); base hard-coded https://api.asaas.com/v3.
ASAAS_API_KEY=
# Opcional: split/wallet (a GESTÃO lê mas não aplica split hoje).
ASAAS_WALLET_ID=
# Token do webhook Asaas (OBRIGATÓRIO para /api/webhooks/asaas funcionar).
ASAAS_WEBHOOK_TOKEN=

# ─── Cupons (registro de resgate via POST — opcional) ─────────────────────────
# Espelha CHECKOUT_API_SECRET da GESTÃO. Só necessário se ativarmos o POST de resgate.
CHECKOUT_API_SECRET=

# ─── Resend (e-mails transacionais) ───────────────────────────────────────────
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Somma Club <contato@sommaclub.com.br>")
VIP_EMAIL_FROM=
# Segredo de assinatura do webhook de eventos (/api/webhooks/resend).
# Vem do `signing_secret` devolvido na CRIAÇÃO do webhook, e só ali: a listagem
# não expõe. OBRIGATÓRIO para a régua de campanhas — sem ele as aberturas não são
# capturadas e as etapas 2 e 3 não sabem quem não abriu.
RESEND_WEBHOOK_SECRET=

# ─── Campanhas (/admin/campanhas) ─────────────────────────────────────────────
# Senha única do módulo de régua de disparo. Quem entra manda e-mail para a base.
CAMPANHAS_ADMIN_PASSWORD=
